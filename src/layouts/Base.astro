---
import '../styles/global.css';
import ChipMark from '../components/ChipMark.astro';
import { appStoreId, appStoreUrl } from '../config';

interface Props {
  title: string;
  description: string;
  /** Pages that are mostly prose get a narrower column and a heading rhythm. */
  prose?: boolean;
  /** schema.org objects for this page, emitted as one ld+json block. */
  schema?: unknown[];
}

const { title, description, prose = false, schema = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0B0D10" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Quiet Poker" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Quiet Poker chip mark and wordmark." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    {
      /* iOS Safari's Smart App Banner. Appears only once there is a listing to
         send people to; until then the meta tag would name an app that cannot
         be opened. */
      appStoreId && (
        <meta name="apple-itunes-app" content={`app-id=${appStoreId}`} />
      )
    }

    {
      schema.length > 0 && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(
            schema.length === 1 ? schema[0] : { '@graph': schema }
          )}
        />
      )
    }

    <meta name="generator" content={Astro.generator} />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href="/">
          <ChipMark size={26} />
          <span>Quiet Poker</span>
        </a>
        <nav aria-label="Site">
          <a href="/#screens">The app</a>
          <a href="/#plans">Plans</a>
          <a href="/support">Support</a>
          <a href="/privacy">Privacy</a>
        </nav>
        {
          appStoreUrl ? (
            <a class="site-header__cta" href={appStoreUrl}>App Store</a>
          ) : (
            <span class="site-header__cta site-header__cta--pending">Coming soon</span>
          )
        }
      </div>
    </header>

    <main id="main" class={prose ? 'prose' : undefined}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__grid">
        <div class="site-footer__brand">
          <a class="brand" href="/">
            <ChipMark size={30} />
            <span>Quiet Poker</span>
          </a>
          <p class="site-footer__tag">Texas Hold&rsquo;em practice for iPhone and iPad. Play chips only.</p>
        </div>

        <nav class="site-footer__links" aria-label="Footer">
          <p class="eyebrow">Site</p>
          <a href="/">Home</a>
          <a href="/#screens">The app</a>
          <a href="/#plans">Plans</a>
          <a href="/#faq">Questions</a>
        </nav>

        <nav class="site-footer__links" aria-label="Legal and support">
          <p class="eyebrow">Help</p>
          <a href="/support">Support</a>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
        </nav>
      </div>

      <div class="wrap site-footer__bottom">
        <!-- These three lines are required and must not be softened. They are
             the same words that go to App Store review. -->
        <p class="site-footer__legal">
          This game is intended for an adult audience. This game does not offer
          real-money gambling or an opportunity to win real money or prizes.
          Practice or success in this game does not imply future success at
          real-money gambling.
        </p>

        <p class="site-footer__legal">
          &copy; {year} Nikolai Kushner. Quiet Poker and the chip mark are
          trademarks of Nikolai Kushner. Not affiliated with Apple Inc.
        </p>
      </div>
    </footer>

    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 5;
        background: color-mix(in srgb, var(--bg) 72%, transparent);
        backdrop-filter: blur(16px) saturate(1.2);
        -webkit-backdrop-filter: blur(16px) saturate(1.2);
        border-bottom: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
      }

      .site-header__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        min-height: 64px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        font-weight: 600;
        letter-spacing: -0.02em;
        text-decoration: none;
        font-size: 1.0625rem;
      }

      .site-header nav {
        display: none;
        gap: 1.75rem;
        font-size: 0.9375rem;
        color: var(--muted);
      }

      @media (min-width: 720px) {
        .site-header nav {
          display: flex;
        }
      }

      .site-header nav a {
        text-decoration: none;
        transition: color 140ms ease;
      }

      .site-header nav a:hover {
        color: var(--text);
      }

      .site-header__cta {
        font-size: 0.875rem;
        font-weight: 600;
        padding: 0.5rem 0.95rem;
        border-radius: 999px;
        text-decoration: none;
        background: var(--cta);
        color: var(--cta-on);
        white-space: nowrap;
      }

      .site-header__cta--pending {
        background: transparent;
        color: var(--muted);
        border: 1px solid var(--border);
        font-weight: 500;
      }

      .site-footer {
        border-top: 1px solid var(--border-soft);
        margin-top: var(--section);
        padding: 3.5rem 0 3rem;
        color: var(--muted);
        font-size: 0.875rem;
      }

      .site-footer__grid {
        display: grid;
        gap: 2.5rem;
        grid-template-columns: 1fr;
      }

      @media (min-width: 720px) {
        .site-footer__grid {
          grid-template-columns: 1.6fr 1fr 1fr;
        }
      }

      .site-footer__brand .brand {
        color: var(--text);
      }

      .site-footer__tag {
        margin-top: 1rem;
        max-width: 22rem;
      }

      .site-footer__links {
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
      }

      .site-footer__links .eyebrow {
        margin-bottom: 0.4rem;
      }

      .site-footer__links a {
        text-decoration: none;
        color: var(--text);
        width: fit-content;
      }

      .site-footer__links a:hover {
        color: var(--accent);
      }

      .site-footer__bottom {
        margin-top: 3rem;
        padding-top: 2rem;
        border-top: 1px solid var(--border-soft);
      }

      .site-footer__legal {
        max-width: 52rem;
        margin-bottom: 0.75rem;
        text-wrap: pretty;
        font-size: 0.8125rem;
      }

      /* Prose pages: privacy, terms, support. One column, generous rhythm. */
      :global(main.prose) {
        width: min(100% - (var(--gutter) * 2), 44rem);
        margin-inline: auto;
        padding-block: clamp(3rem, 8vw, 5rem) 1rem;
      }

      :global(main.prose h1) {
        font-size: var(--step-3);
      }

      :global(main.prose h2) {
        font-size: var(--step-2);
        margin-top: 2.75rem;
        margin-bottom: 0.75rem;
      }

      :global(main.prose h3) {
        font-size: var(--step-1);
        margin-top: 1.75rem;
        margin-bottom: 0.5rem;
      }

      :global(main.prose p),
      :global(main.prose ul),
      :global(main.prose ol) {
        margin-block: 0 1rem;
      }

      :global(main.prose li) {
        margin-bottom: 0.5rem;
      }

      :global(main.prose ul),
      :global(main.prose ol) {
        padding-left: 1.25rem;
      }

      :global(main.prose strong) {
        color: var(--text);
        font-weight: 600;
      }
    </style>
  </body>
</html>
