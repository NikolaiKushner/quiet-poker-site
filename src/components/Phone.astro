---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  /** The first screenshot on the page is worth loading eagerly. */
  eager?: boolean;
}

const { src, alt, caption, eager = false } = Astro.props;
---

<figure class="phone">
  <div class="phone__frame">
    <Image
      src={src}
      alt={alt}
      widths={[320, 430, 860]}
      sizes="(max-width: 640px) 70vw, 260px"
      loading={eager ? 'eager' : 'lazy'}
      decoding={eager ? 'sync' : 'async'}
    />
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .phone {
    margin: 0;
    flex: 0 0 auto;
    width: min(70vw, 260px);
  }

  .phone__frame {
    border: 1px solid var(--border);
    border-radius: 28px;
    overflow: hidden;
    background: var(--bg);
    /* The screenshots are already black to the edges, so the frame reads as
       the device rather than as a box drawn around a picture. */
    box-shadow: 0 18px 50px -24px rgb(0 0 0 / 0.9);
  }

  figcaption {
    margin-top: 0.875rem;
    font-size: 0.875rem;
    color: var(--muted);
    text-wrap: pretty;
  }
</style>
