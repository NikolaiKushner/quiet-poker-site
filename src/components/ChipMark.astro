---
/* The brand mark: black chip, eight white edge notches, white clubs centre.
   Inline rather than an <img> so it inherits currentColor nowhere and stays
   crisp at the 24px the header uses and the 512px the OG image uses. */
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 64 64"
  role="img"
  aria-label="Quiet Poker"
  class={className}
>
  <!-- The brand rim is solid black. On this page the background is nearly
       black too, so without a hairline edge the chip reads as a starburst:
       only the notches and the clubs would show. -->
  <circle cx="32" cy="32" r="31" fill="#000000" stroke="#FFFFFF"
    stroke-opacity="0.28" stroke-width="1.5" />
  <g fill="#FFFFFF">
    {[0, 45, 90, 135, 180, 225, 270, 315].map((angle) => (
      <rect
        x="29.4"
        y="1.6"
        width="5.2"
        height="7.4"
        rx="1.6"
        transform={`rotate(${angle} 32 32)`}
      />
    ))}
  </g>
  <circle cx="32" cy="32" r="22" fill="none" stroke="#FFFFFF" stroke-width="1.6" />
  <g fill="#FFFFFF">
    <circle cx="32" cy="27.4" r="4.6" />
    <circle cx="27.1" cy="35.2" r="4.6" />
    <circle cx="36.9" cy="35.2" r="4.6" />
    <path d="M30.1 33.6 Q31.1 40.4 27.4 44.6 L36.6 44.6 Q32.9 40.4 33.9 33.6 Z" />
  </g>
</svg>
