---
import Base from '../layouts/Base.astro';
import Phone from '../components/Phone.astro';
import ChipMark from '../components/ChipMark.astro';
import { appStoreUrl, supportEmail } from '../config';

import table from '../assets/screenshots/table.png';
import lobby from '../assets/screenshots/lobby.png';
import setup from '../assets/screenshots/setup.png';
import flop from '../assets/screenshots/flop.png';
import showdown from '../assets/screenshots/showdown.png';
import sitgo from '../assets/screenshots/sitgo.png';
import privateRooms from '../assets/screenshots/private.png';

const shots = [
  {
    src: lobby,
    alt: "The Quiet Poker lobby on iPhone: an offline cash game, a six-player Sit & Go, private rooms joined with a code, and outs and pot-odds drills.",
    caption: 'Two offline games, private rooms, two drills. No lobby to wait in.',
  },
  {
    src: setup,
    alt: 'The table setup screen, offering six-max or heads-up, bots on Easy, Standard or Hard, and one slider that moves blinds and buy-in together.',
    caption: 'Six-max or heads-up, three levels of opposition, seven levels of stakes.',
  },
  {
    src: flop,
    alt: "A six-handed offline Texas Hold'em table in portrait on iPhone, the flop dealt and the Fold, Call and Raise buttons along the bottom of the screen.",
    caption: 'The flop, the pot, and three buttons in the same three places.',
  },
  {
    src: showdown,
    alt: 'A Texas Hold’em showdown with the full board dealt, the winning hand named, and the amount won shown beneath the hole cards.',
    caption: 'Showdown names the hand that won and what it paid.',
  },
  {
    src: sitgo,
    alt: 'The Sit & Go screen offering a Standard and a High Roller tournament, each showing its entry, blinds, starting stack and prize pool.',
    caption: 'Sit & Go: six players, top three paid, no rebuys.',
  },
  {
    src: privateRooms,
    alt: 'The private rooms screen, with a button to open a six-seat room and six boxes for typing a room code.',
    caption: 'Open a room, send the six-digit code. That is the whole setup.',
  },
];

const steps = [
  {
    n: '01',
    title: 'Open the app',
    body: 'No sign-up, no email, no lobby queue. Offline play needs no account and no connection.',
  },
  {
    n: '02',
    title: 'Set the table',
    body: 'Six-max or heads-up, bots on Easy, Standard or Hard, and one slider for the stakes — seven levels from 1/2 to 100/200, each of them 100 big blinds deep.',
  },
  {
    n: '03',
    title: 'Play a hand',
    body: 'Dealt immediately. Fold, check or call, and raise sit under your thumb in the same order on every street.',
  },
];

const features = [
  {
    title: 'Practise Hold’em offline, with no connection',
    body: 'A table against bots, dealt the moment you open it, six-max or heads-up. On a plane, on the Underground, in a queue — no signal and no account needed.',
  },
  {
    title: 'A tournament that ends',
    body: 'Sit & Go: six players, one entry, blinds that climb every eight hands and no rebuys. Top three are paid, and when you are out it is over — a session with a result at the end of it, not a table you have to decide when to leave.',
  },
  {
    title: 'Opposition you can turn up',
    body: 'Easy, Standard or Hard, picked before you sit and shared by everyone at the table. Easy forgives a bad call. Hard reads ranges properly and rarely hands you anything.',
  },
  {
    title: 'Built to be played one-handed',
    body: 'Portrait, always. Fold, check or call, and raise stay at the bottom of the screen in the same three places on every street, so the hand becomes muscle memory. Swipe up to fold, or arm your action before the turn reaches you.',
  },
  {
    title: 'Outs and pot-odds drills',
    body: 'Count the cards that help. Call or fold on the number. Short practice for the two decisions that cost the most, away from the table with nothing riding on it.',
  },
  {
    title: 'Private rooms with friends',
    body: 'Open a six-seat room, set the stakes and the time per turn, and send the six-digit code. A home game that does not need everybody in the same room, and no money anywhere near it.',
  },
  {
    title: 'Statistics that name the leak',
    body: 'VPIP, PFR, 3-bet and postflop aggression, plotted against the styles they add up to — tight or loose, aggressive or passive — with the recent hands behind them. A leak becomes something you can see rather than suspect.',
  },
  {
    title: 'No ads. No tracking. No data broker.',
    body: 'The app contains no advertising and no analytics software from anyone. Nothing about you is sold or shared, and offline play sends nothing anywhere.',
  },
];

const audiences = [
  {
    title: 'Learning Texas Hold’em',
    body: 'Hands cost nothing, so you can play the spot ten times instead of reading about it once. Start the bots on Easy, and tap the board for the hand guide whenever you are not sure what beats what.',
  },
  {
    title: 'Keeping sharp between home games',
    body: 'Ranges, pace and pot control go stale between sessions. Twenty hands against bots on the way to work, or one Sit & Go, keeps them from it.',
  },
  {
    title: 'Hosting the game yourself',
    body: 'A private room and a code is the whole setup. Nobody installs a client, nobody sends anybody money, and nobody has to host in their kitchen.',
  },
];

const faqs = [
  {
    q: 'Is Quiet Poker real-money gambling?',
    a: 'No. Quiet Poker is play chips only. They have no cash value, cannot be cashed out, sold, transferred to another player, or wagered on anything. There is no real-money game in the app and no way to win money or prizes.',
  },
  {
    q: 'Can I play poker offline, with no internet?',
    a: 'Yes. The offline table against bots is the app’s main mode, and the Sit & Go tournament is offline too. Neither needs a connection or an account. A connection is only needed for private rooms and for carrying your chips to another device.',
  },
  {
    q: 'What is a Sit & Go?',
    a: 'A six-player tournament against bots. Everyone starts on the same stack, the blinds climb every eight hands, there are no rebuys, and the last three standing are paid. Two entries to choose from, Standard and High Roller, and the bots can be set to Easy, Standard or Hard.',
  },
  {
    q: 'Can I play heads-up?',
    a: 'Yes. The cash table is six-max or heads-up — pick it in table setup, along with the difficulty and the stakes, before you sit down.',
  },
  {
    q: 'Do I need an account to play?',
    a: 'Not for offline play — open the app and you are dealt in, and nothing about you is stored anywhere. Signing in with Apple is what lets your chips and subscription follow you to another device, and what private rooms need.',
  },
  {
    q: 'Can I play poker with friends?',
    a: 'Yes. Open a private room and send friends the six-digit code. Only people with the code can sit down, and everyone buys in for the same amount.',
  },
  {
    q: 'Does the app have ads?',
    a: 'No. There is no advertising software in the app, and no analytics software either, from anyone. Nothing about you is sold or shared.',
  },
  {
    q: 'What does the Plus subscription add?',
    a: 'A larger daily chip reward on top of the standard one, and every card back and table colour for as long as you subscribe. It changes nothing at the table: the bots, the stakes and the private room are the same with it or without it. It renews until cancelled, and you cancel it in Settings or from the Shop tab.',
  },
  {
    q: 'Can I cash out my chips?',
    a: 'No, and that is deliberate. Chips are there to keep playing with. A chip pack buys chips the way a level pack buys levels — not a stake, and not a balance.',
  },
  {
    q: 'Which devices does it run on?',
    a: 'iPhone and iPad. The table is portrait on iPhone, by design, so it can be played with one thumb; iPad gets more seat room and allows landscape.',
  },
];

const title = "Quiet Poker — Texas Hold'em Practice App for iPhone";
const description =
  "Practise Texas Hold'em on iPhone with play chips only. Offline six-max and heads-up against bots, Sit & Go tournaments, private rooms, outs and pot-odds drills. No ads, no tracking.";

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: 'Quiet Poker',
    applicationCategory: 'GameApplication',
    applicationSubCategory: 'Card Game',
    operatingSystem: 'iOS',
    description,
    url: 'https://quietpoker.app/',
    inLanguage: 'en',
    isFamilyFriendly: false,
    contentRating: 'Simulated gambling; intended for an adult audience',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
      description:
        'Free to play with play chips. Optional Plus subscription and one-off chip packs are sold through the App Store.',
    },
    featureList: [
      "Offline six-max and heads-up Texas Hold'em against bots",
      'Six-player Sit & Go tournaments against bots',
      'Bot difficulty set to Easy, Standard or Hard',
      'Private rooms joined with a six-digit code',
      'Outs and pot-odds practice drills',
      'VPIP, PFR, 3-bet and aggression statistics with hand history',
      'One-handed portrait table',
      'No advertising or analytics software',
    ],
    author: { '@type': 'Person', name: 'Nikolai Kushner' },
    publisher: { '@type': 'Person', name: 'Nikolai Kushner' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<Base title={title} description={description} schema={schema}>
  <section class="hero">
    <div class="wrap hero__inner">
      <div class="hero__copy">
        <p class="eyebrow">Texas Hold&rsquo;em &middot; iPhone and iPad</p>
        <h1>Texas Hold&rsquo;em practice, without the noise.</h1>
        <p class="lede">
          A calm Hold&rsquo;em table you can play with one thumb. Sit down
          against bots in a second with no connection and no account, play a
          Sit &amp; Go that actually ends, or open a private room and send
          friends the code. Play chips only &mdash; nothing to cash out, and
          nothing to win.
        </p>

        {
          appStoreUrl ? (
            <a class="cta" href={appStoreUrl}>
              Download on the App Store
            </a>
          ) : (
            <p class="cta cta--pending">
              <ChipMark size={18} />
              Coming to the App Store
            </p>
          )
        }

        <ul class="hero__points">
          <li>No ads, no analytics, no data broker</li>
          <li>Works with no signal</li>
          <li>Free to play</li>
        </ul>
      </div>

      <div class="hero__shot">
        <Phone
          src={table}
          alt="A six-handed Quiet Poker Texas Hold'em table in portrait on iPhone, with the Fold, Call and Raise buttons along the bottom of the screen."
          eager
        />
      </div>
    </div>
  </section>

  <section class="wrap section">
    <p class="eyebrow">How it works</p>
    <h2>Three taps and you are in a hand.</h2>
    <p class="lede">
      No lobby to wait in, no table to hunt for, and nothing to fill in first.
    </p>

    <ol class="steps">
      {
        steps.map((step) => (
          <li>
            <span class="steps__n">{step.n}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap section">
    <p class="eyebrow">What it looks like</p>
    <h2>Six screens, and that is most of the app.</h2>
    <p class="lede">
      One table, one theme, and no second screen doing the same job as the
      first.
    </p>

    <div class="shots" role="group" aria-label="Screenshots">
      {shots.map((shot) => <Phone src={shot.src} alt={shot.alt} caption={shot.caption} />)}
    </div>
  </section>

  <section class="wrap section">
    <p class="eyebrow">Why here</p>
    <h2>A poker app that stays out of the way.</h2>

    <ul class="features">
      {
        features.map((feature) => (
          <li>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap section">
    <p class="eyebrow">Who it is for</p>
    <h2>Three people it was built for.</h2>

    <div class="audiences">
      {
        audiences.map((audience) => (
          <div>
            <h3>{audience.title}</h3>
            <p>{audience.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="wrap section">
    <p class="eyebrow">Plans</p>
    <h2>Free to play, with an optional Plus subscription.</h2>
    <p class="lede">
      Prices are set per country and shown in your own currency in the
      app&rsquo;s Shop tab, so they are not printed here.
    </p>

    <div class="plans">
      <div class="plan">
        <h3>Free</h3>
        <p class="plan__note">Everything on this page.</p>
        <ul>
          <li>Offline cash games, six-max or heads-up, at every level your bank covers</li>
          <li>Sit &amp; Go tournaments, Standard and High Roller</li>
          <li>Private rooms, opened or joined with a code</li>
          <li>The outs and pot-odds drills</li>
          <li>Your statistics and hand history</li>
          <li>A chip reward every day</li>
        </ul>
      </div>

      <div class="plan plan--featured">
        <h3>Plus</h3>
        <p class="plan__note">Monthly or yearly. Cancel in Settings, as with any subscription.</p>
        <ul>
          <li>A larger daily chip reward, on top of the standard one</li>
          <li>Every card back and table colour, while you subscribe</li>
          <li>Nothing that changes a hand &mdash; everyone gets a private room, Plus or not</li>
        </ul>
      </div>

      <div class="plan">
        <h3>Chip packs</h3>
        <p class="plan__note">One-off, for when the bank runs dry.</p>
        <ul>
          <li>Six sizes, bought once</li>
          <li>Play chips never expire</li>
          <li>No subscription needed</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <p class="eyebrow">Questions</p>
    <h2>Asked often enough to answer here.</h2>

    <div class="faq">
      {
        faqs.map((faq) => (
          <details>
            <summary>
              <h3>{faq.q}</h3>
            </summary>
            <p>{faq.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="wrap section">
    <div class="note">
      <h2>Play chips, and only play chips.</h2>
      <p>
        The chips in Quiet Poker have no cash value. They cannot be bought back,
        cashed out, transferred to another player, or wagered on anything. A
        chip pack buys chips to keep playing with, the way a level pack buys
        levels &mdash; not a stake and not a balance.
      </p>
      <p>
        Nothing here prepares you to gamble for money, and it is not meant to.
      </p>
      <p class="note__contact">
        Anything else: <a href={`mailto:${supportEmail}`}>{supportEmail}</a>, or
        the <a href="/support">support page</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .section {
    margin-top: 5.5rem;
  }

  .hero {
    padding-block: clamp(3rem, 8vw, 6rem) 0;
  }

  .hero__inner {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }

  @media (min-width: 820px) {
    .hero__inner {
      grid-template-columns: 1fr auto;
    }
  }

  .hero__copy > * + * {
    margin-top: 1.25rem;
  }

  .hero__shot {
    justify-self: center;
  }

  .hero__points {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .hero__points li::before {
    content: '\2713';
    color: var(--accent);
    margin-right: 0.45rem;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--cta);
    color: var(--cta-on);
    font-weight: 600;
    padding: 0.85rem 1.4rem;
    border-radius: 999px;
    text-decoration: none;
    min-height: 52px;
  }

  /* Until there is a listing, this is a statement rather than a button: it is
     not a link, it does not look pressable, and there is nothing to 404. */
  .cta--pending {
    background: var(--elevated);
    color: var(--muted);
    border: 1px solid var(--border);
    font-weight: 500;
  }

  .steps {
    list-style: none;
    counter-reset: none;
    padding: 0;
    margin: 2.5rem 0 0;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .steps__n {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-bottom: 0.6rem;
  }

  .steps p {
    margin-top: 0.6rem;
    color: var(--muted);
  }

  .shots {
    display: flex;
    gap: 1.75rem;
    margin-top: 2.5rem;
    overflow-x: auto;
    /* Proximity, not mandatory, and scroll-padding matching the inline padding.
       Mandatory snapping resolves on load against the first item's snap point,
       which sits after the padding — the row arrived already scrolled past its
       own left inset, flush to the viewport edge. */
    scroll-snap-type: x proximity;
    scroll-padding-inline: max(var(--gutter), calc((100vw - var(--page)) / 2));
    /* Bleeds to the viewport edge rather than stopping at the page column:
       clipped flush against the column, a scroller looks like a broken grid. */
    padding-inline: max(var(--gutter), calc((100vw - var(--page)) / 2));
    margin-inline: calc(50% - 50vw);
    width: 100vw;
    padding-bottom: 1rem;
    scrollbar-width: thin;
  }

  .shots > :global(.phone) {
    scroll-snap-align: start;
  }

  .features {
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 0;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }

  .features li {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.5rem;
  }

  .features p,
  .audiences p {
    margin-top: 0.6rem;
    color: var(--muted);
  }

  .audiences {
    display: grid;
    gap: 2rem;
    margin-top: 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }

  .plans {
    display: grid;
    gap: 1.25rem;
    margin-top: 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .plan {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.75rem;
  }

  .plan--featured {
    border-color: var(--accent);
  }

  .plan__note {
    color: var(--muted);
    font-size: 0.9375rem;
    margin-top: 0.4rem;
  }

  .plan ul {
    margin: 1.25rem 0 0;
    padding-left: 1.1rem;
    color: var(--muted);
  }

  .plan li {
    margin-bottom: 0.5rem;
  }

  .faq {
    margin-top: 2.5rem;
    border-top: 1px solid var(--border);
    max-width: 48rem;
  }

  .faq details {
    border-bottom: 1px solid var(--border);
  }

  .faq summary {
    cursor: pointer;
    padding: 1.1rem 2rem 1.1rem 0;
    position: relative;
    list-style: none;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary h3 {
    display: inline;
    font-size: var(--step-0);
    font-weight: 600;
  }

  .faq summary::after {
    content: '+';
    position: absolute;
    right: 0.25rem;
    top: 50%;
    translate: 0 -50%;
    color: var(--muted);
    font-size: 1.25rem;
    line-height: 1;
  }

  .faq details[open] summary::after {
    content: '\2212';
  }

  .faq p {
    color: var(--muted);
    padding-bottom: 1.25rem;
    max-width: var(--measure);
  }

  .note {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: clamp(1.75rem, 4vw, 2.75rem);
  }

  .note p {
    color: var(--muted);
    max-width: var(--measure);
    margin-top: 1rem;
  }

  .note__contact {
    color: var(--text);
  }
</style>
