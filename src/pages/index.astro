---
import Base from '../layouts/Base.astro';
import Phone from '../components/Phone.astro';
import Card from '../components/Card.astro';
import ChipMark from '../components/ChipMark.astro';
import { appStoreUrl, supportEmail } from '../config';

import table from '../assets/screenshots/table.png';
import lobby from '../assets/screenshots/lobby.png';
import setup from '../assets/screenshots/setup.png';
import flop from '../assets/screenshots/flop.png';
import showdown from '../assets/screenshots/showdown.png';
import sitgo from '../assets/screenshots/sitgo.png';
import privateRooms from '../assets/screenshots/private.png';

/* Every claim on this page is about the build people can download today. The
   wording of a feature lives here once and is reused by the schema below. */

const facts = [
  { k: 'Account', v: 'None needed' },
  { k: 'Signal', v: 'Works with none' },
  { k: 'Ads', v: 'None, ever' },
  { k: 'Chips', v: 'Play only' },
];

const scenes = [
  {
    id: 'sit-down',
    eyebrow: 'Sit down',
    title: 'Dealt in before the kettle boils.',
    body: 'Open the app and the table is there. Six-max or heads-up, bots on Easy, Standard or Hard, and one slider that moves blinds and buy-in together, seven levels from 1/2 to 100/200, each of them 100 big blinds deep.',
    points: ['No sign-up and no lobby', 'Three levels of opposition', 'Seven levels of stakes'],
    front: {
      src: setup,
      alt: 'The table setup screen, offering six-max or heads-up, bots on Easy, Standard or Hard, and one slider that moves blinds and buy-in together.',
    },
    back: {
      src: lobby,
      alt: "The Quiet Poker lobby on iPhone: an offline cash game, a six-player Sit & Go, private rooms joined with a code, and outs and pot-odds drills.",
    },
  },
  {
    id: 'one-thumb',
    eyebrow: 'Play',
    title: 'Built for one thumb, in portrait, always.',
    body: 'Fold, check or call, and raise sit at the bottom of the screen in the same three places on every street, so a hand becomes muscle memory. Swipe up to fold. Arm your action before the turn reaches you. Showdown names the hand that won and what it paid.',
    points: ['Same three buttons on every street', 'Swipe up to fold', 'Tap the board for the hand guide'],
    front: {
      src: flop,
      alt: "A six-handed offline Texas Hold'em table in portrait on iPhone, the flop dealt and the Fold, Call and Raise buttons along the bottom of the screen.",
    },
    back: {
      src: showdown,
      alt: 'A Texas Hold’em showdown with the full board dealt, the winning hand named, and the amount won shown beneath the hole cards.',
    },
  },
  {
    id: 'a-result',
    eyebrow: 'Finish',
    title: 'A tournament that ends. A room for friends.',
    body: 'Sit & Go: six players, blinds that climb every eight hands, no rebuys, top three paid. When you are out it is over. Or open a private room, set the stakes and the time per turn, and send the six-digit code. A home game with no money anywhere near it.',
    points: ['Standard and High Roller entries', 'Six-seat private rooms', 'One code is the whole setup'],
    front: {
      src: sitgo,
      alt: 'The Sit & Go screen offering a Standard and a High Roller tournament, each showing its entry, blinds, starting stack and prize pool.',
    },
    back: {
      src: privateRooms,
      alt: 'The private rooms screen, with a button to open a six-seat room and six boxes for typing a room code.',
    },
  },
];

const steps = [
  {
    n: '01',
    title: 'Open the app',
    body: 'No sign-up, no email, no lobby queue. Offline play needs no account and no connection.',
  },
  {
    n: '02',
    title: 'Set the table',
    body: 'Six-max or heads-up, bots on Easy, Standard or Hard, and one slider for the stakes.',
  },
  {
    n: '03',
    title: 'Play a hand',
    body: 'Dealt immediately. Fold, check or call, and raise sit under your thumb in the same order on every street.',
  },
];

const features = [
  {
    title: 'Practise Hold’em offline, with no connection',
    body: 'A table against bots, dealt the moment you open it, six-max or heads-up. On a plane, on the Underground, in a queue: no signal and no account needed.',
    wide: true,
  },
  {
    title: 'Opposition you can turn up',
    body: 'Easy forgives a bad call. Hard reads ranges properly and rarely hands you anything. Picked before you sit, shared by everyone at the table.',
    wide: true,
  },
  {
    title: 'A tournament that ends',
    body: 'Six players, one entry, blinds that climb, no rebuys. A session with a result at the end of it, not a table you have to decide when to leave.',
  },
  {
    title: 'Outs and pot-odds drills',
    body: 'Count the cards that help. Call or fold on the number. Short practice for the two decisions that cost the most, with nothing riding on it.',
  },
  {
    title: 'Private rooms with friends',
    body: 'Open a six-seat room, set the stakes and the time per turn, and send the six-digit code. Only people with the code can sit down.',
  },
  {
    title: 'Statistics that name the leak',
    body: 'VPIP, PFR, 3-bet and postflop aggression, plotted against the styles they add up to, with the recent hands behind them. A leak becomes something you can see rather than suspect.',
  },
  {
    title: 'No ads. No tracking. No data broker.',
    body: 'The app contains no advertising and no analytics software from anyone. Nothing about you is sold or shared, and offline play sends nothing anywhere.',
  },
  {
    title: 'One table, one theme',
    body: 'A flat studio surface, large type, high-contrast cards. No neon, no oval felt, no second screen doing the same job as the first.',
  },
];

const audiences = [
  {
    title: 'Learning Texas Hold’em',
    body: 'Hands cost nothing, so you can play the spot ten times instead of reading about it once. Start the bots on Easy, and tap the board for the hand guide whenever you are not sure what beats what.',
  },
  {
    title: 'Keeping sharp between home games',
    body: 'Ranges, pace and pot control go stale between sessions. Twenty hands against bots on the way to work, or one Sit & Go, keeps them from it.',
  },
  {
    title: 'Hosting the game yourself',
    body: 'A private room and a code is the whole setup. Nobody installs a client, nobody sends anybody money, and nobody has to host in their kitchen.',
  },
];

const faqs = [
  {
    q: 'Is Quiet Poker real-money gambling?',
    a: 'No. Quiet Poker is play chips only. They have no cash value, cannot be cashed out, sold, transferred to another player, or wagered on anything. There is no real-money game in the app and no way to win money or prizes.',
  },
  {
    q: 'Can I play poker offline, with no internet?',
    a: 'Yes. The offline table against bots is the app’s main mode, and the Sit & Go tournament is offline too. Neither needs a connection or an account. A connection is only needed for private rooms and for carrying your chips to another device.',
  },
  {
    q: 'What is a Sit & Go?',
    a: 'A six-player tournament against bots. Everyone starts on the same stack, the blinds climb every eight hands, there are no rebuys, and the last three standing are paid. Two entries to choose from, Standard and High Roller, and the bots can be set to Easy, Standard or Hard.',
  },
  {
    q: 'Can I play heads-up?',
    a: 'Yes. The cash table is six-max or heads-up. Pick it in table setup, along with the difficulty and the stakes, before you sit down.',
  },
  {
    q: 'Do I need an account to play?',
    a: 'Not for offline play. Open the app and you are dealt in, and nothing about you is stored anywhere. Signing in with Apple is what lets your chips and subscription follow you to another device, and what private rooms need.',
  },
  {
    q: 'Can I play poker with friends?',
    a: 'Yes. Open a private room and send friends the six-digit code. Only people with the code can sit down, and everyone buys in for the same amount.',
  },
  {
    q: 'Does the app have ads?',
    a: 'No. There is no advertising software in the app, and no analytics software either, from anyone. Nothing about you is sold or shared.',
  },
  {
    q: 'What does the Plus subscription add?',
    a: 'A larger daily chip reward on top of the standard one, and every card back and table colour for as long as you subscribe. It changes nothing at the table: the bots, the stakes and the private room are the same with it or without it. It renews until cancelled, and you cancel it in Settings or from the Shop tab.',
  },
  {
    q: 'Can I cash out my chips?',
    a: 'No, and that is deliberate. Chips are there to keep playing with. A chip pack buys chips the way a level pack buys levels: not a stake, and not a balance.',
  },
  {
    q: 'Which devices does it run on?',
    a: 'iPhone and iPad. The table is portrait on iPhone, by design, so it can be played with one thumb; iPad gets more seat room and allows landscape.',
  },
];

const title = "Quiet Poker — Texas Hold'em Practice App for iPhone";
const description =
  "Practise Texas Hold'em on iPhone with play chips only. Offline six-max and heads-up against bots, Sit & Go tournaments, private rooms, outs and pot-odds drills. No ads, no tracking.";

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: 'Quiet Poker',
    applicationCategory: 'GameApplication',
    applicationSubCategory: 'Card Game',
    operatingSystem: 'iOS',
    description,
    url: 'https://quietpoker.app/',
    inLanguage: 'en',
    isFamilyFriendly: false,
    contentRating: 'Simulated gambling; intended for an adult audience',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
      description:
        'Free to play with play chips. Optional Plus subscription and one-off chip packs are sold through the App Store.',
    },
    featureList: [
      "Offline six-max and heads-up Texas Hold'em against bots",
      'Six-player Sit & Go tournaments against bots',
      'Bot difficulty set to Easy, Standard or Hard',
      'Private rooms joined with a six-digit code',
      'Outs and pot-odds practice drills',
      'VPIP, PFR, 3-bet and aggression statistics with hand history',
      'One-handed portrait table',
      'No advertising or analytics software',
    ],
    author: { '@type': 'Person', name: 'Nikolai Kushner' },
    publisher: { '@type': 'Person', name: 'Nikolai Kushner' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<Base title={title} description={description} schema={schema}>
  <!-- Hero: the table under a studio light, two cards on the felt. -->
  <section class="hero">
    <div class="hero__light" aria-hidden="true"></div>
    <div class="wrap hero__inner">
      <div class="hero__copy">
        <p class="eyebrow">Texas Hold&rsquo;em &middot; iPhone and iPad</p>
        <h1>
          Texas Hold&rsquo;em practice,
          <span class="hero__soft">without the noise.</span>
        </h1>
        <p class="lede">
          A calm table you can play with one thumb. Sit down against bots in a
          second with no connection and no account, play a Sit&nbsp;&amp;&nbsp;Go
          that actually ends, or open a private room and send friends the code.
          Play chips only: nothing to cash out, nothing to win.
        </p>

        <div class="hero__actions">
          {
            appStoreUrl ? (
              <a class="btn btn--primary" href={appStoreUrl}>
                Download on the App Store
              </a>
            ) : (
              <span class="btn btn--pending">
                <ChipMark size={18} />
                Coming to the App Store
              </span>
            )
          }
          <a class="btn btn--ghost" href="#screens">See the table</a>
        </div>
      </div>

      <div class="hero__stage">
        <Card rank="A" suit="clubs" class="hero__card hero__card--a" />
        <Card rank="K" suit="hearts" class="hero__card hero__card--k" />
        <Phone
          class="hero__phone"
          width="clamp(230px, 24vw, 330px)"
          src={table}
          alt="A six-handed Quiet Poker Texas Hold'em table in portrait on iPhone, with the Fold, Call and Raise buttons along the bottom of the screen."
          eager
        />
      </div>
    </div>

    <div class="wrap">
      <dl class="facts">
        {
          facts.map((f) => (
            <div class="facts__item">
              <dt class="eyebrow">{f.k}</dt>
              <dd>{f.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Three scenes, each a pair of screens and the sentence they earn. -->
  <section class="wrap section" id="screens">
    <header class="section__head reveal">
      <p class="eyebrow">What it looks like</p>
      <h2>Six screens, and that is most of the app.</h2>
      <p class="lede">
        One table, one theme, and no second screen doing the same job as the
        first.
      </p>
    </header>

    <div class="scenes">
      {
        scenes.map((scene, i) => (
          <article class:list={['scene', 'reveal', i % 2 === 1 && 'scene--flip']} id={scene.id}>
            <div class="scene__copy">
              <p class="eyebrow">{scene.eyebrow}</p>
              <h3>{scene.title}</h3>
              <p class="scene__body">{scene.body}</p>
              <ul class="scene__points">
                {scene.points.map((p) => <li>{p}</li>)}
              </ul>
            </div>
            <div class="scene__stage">
              <Phone class="scene__phone scene__phone--back" width="46%" src={scene.back.src} alt={scene.back.alt} />
              <Phone class="scene__phone scene__phone--front" width="54%" src={scene.front.src} alt={scene.front.alt} />
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- How it works: three steps on one rail. -->
  <section class="wrap section reveal">
    <header class="section__head">
      <p class="eyebrow">How it works</p>
      <h2>Three taps and you are in a hand.</h2>
    </header>

    <ol class="steps">
      {
        steps.map((step) => (
          <li>
            <span class="steps__n">{step.n}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Features: a bento of eight, two of them wide. -->
  <section class="wrap section reveal" id="features">
    <header class="section__head">
      <p class="eyebrow">Why here</p>
      <h2>A poker app that stays out of the way.</h2>
    </header>

    <ul class="bento">
      {
        features.map((feature, i) => (
          <li class:list={['bento__cell', feature.wide && 'bento__cell--wide']}>
            <span class="bento__n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Who it is for: heading left, three columns right. -->
  <section class="wrap section split reveal">
    <header class="section__head split__head">
      <p class="eyebrow">Who it is for</p>
      <h2>Three people it was built for.</h2>
    </header>

    <div class="audiences">
      {
        audiences.map((audience) => (
          <div class="audience">
            <h3>{audience.title}</h3>
            <p>{audience.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Plans: no prices, by rule. -->
  <section class="wrap section reveal" id="plans">
    <header class="section__head">
      <p class="eyebrow">Plans</p>
      <h2>Free to play, with an optional Plus subscription.</h2>
      <p class="lede">
        Prices are set per country and shown in your own currency in the
        app&rsquo;s Shop tab, so they are not printed here.
      </p>
    </header>

    <div class="plans">
      <div class="plan">
        <p class="eyebrow">Free</p>
        <h3>Everything on this page.</h3>
        <ul>
          <li>Offline cash games, six-max or heads-up, at every level your bank covers</li>
          <li>Sit &amp; Go tournaments, Standard and High Roller</li>
          <li>Private rooms, opened or joined with a code</li>
          <li>The outs and pot-odds drills</li>
          <li>Your statistics and hand history</li>
          <li>A chip reward every day</li>
        </ul>
      </div>

      <div class="plan plan--featured">
        <ChipMark size={220} class="plan__mark" />
        <p class="eyebrow">Plus</p>
        <h3>More chips a day, every table colour.</h3>
        <p class="plan__note">Monthly or yearly. Cancel in Settings, as with any subscription.</p>
        <ul>
          <li>A larger daily chip reward, on top of the standard one</li>
          <li>Every card back and table colour, while you subscribe</li>
          <li>Nothing that changes a hand. Everyone gets a private room, Plus or not</li>
        </ul>
      </div>

      <div class="plan">
        <p class="eyebrow">Chip packs</p>
        <h3>One-off, for when the bank runs dry.</h3>
        <ul>
          <li>Six sizes, bought once</li>
          <li>Play chips never expire</li>
          <li>No subscription needed</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Questions: heading left, answers right. -->
  <section class="wrap section split reveal" id="faq">
    <header class="section__head split__head">
      <p class="eyebrow">Questions</p>
      <h2>Asked often enough to answer here.</h2>
      <p class="lede">
        Anything else: <a href={`mailto:${supportEmail}`}>{supportEmail}</a>, or
        the <a href="/support">support page</a>.
      </p>
    </header>

    <div class="faq">
      {
        faqs.map((faq) => (
          <details>
            <summary>
              <h3>{faq.q}</h3>
            </summary>
            <p>{faq.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- The felt: the closing statement sits on the table itself. -->
  <section class="wrap section reveal">
    <div class="felt">
      <div class="felt__copy">
        <p class="eyebrow">Play chips, and only play chips</p>
        <h2>Nothing to cash out. Nothing to win. Just poker, at your own pace.</h2>
        <p>
          The chips in Quiet Poker have no cash value. They cannot be bought
          back, cashed out, transferred to another player, or wagered on
          anything. Nothing here prepares you to gamble for money, and it is
          not meant to.
        </p>
        {
          appStoreUrl ? (
            <a class="btn btn--primary" href={appStoreUrl}>Download on the App Store</a>
          ) : (
            <span class="btn btn--pending"><ChipMark size={18} /> Coming to the App Store</span>
          )
        }
      </div>
      <div class="felt__cards" aria-hidden="true">
        <Card rank="10" suit="spades" class="felt__card" />
        <Card rank="J" suit="diamonds" class="felt__card" />
        <Card rank="Q" suit="clubs" class="felt__card" />
        <Card rank="K" suit="hearts" class="felt__card" />
        <Card rank="A" suit="spades" class="felt__card" />
      </div>
    </div>
  </section>
</Base>

<style>
  .section {
    margin-top: var(--section);
  }

  .section__head {
    max-width: 44rem;
  }

  /* ---- Hero ------------------------------------------------------------ */

  .hero {
    position: relative;
    padding-top: clamp(3rem, 9vw, 7rem);
    isolation: isolate;
  }

  /* One soft studio light from above, falling on the table. Monochrome: the
     brand has no colour to lean on, so the depth has to come from light. */
  .hero__light {
    position: absolute;
    inset: -20% -10% auto;
    height: 120%;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(ellipse 55% 45% at 68% 30%, rgb(242 244 247 / 0.11), transparent 70%),
      radial-gradient(ellipse 40% 30% at 20% 10%, rgb(242 244 247 / 0.04), transparent 70%);
    mask-image: linear-gradient(to bottom, #000 60%, transparent);
  }

  .hero__inner {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }

  @media (min-width: 880px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    }
  }

  /* Sized to the copy column rather than the viewport, so the second line
     stays one line on a laptop instead of breaking into a fourth. */
  .hero h1 {
    font-size: clamp(2.5rem, 1rem + 4vw, 4.25rem);
  }

  .hero__copy > * + * {
    margin-top: 1.5rem;
  }

  .hero__copy .lede {
    max-width: 36rem;
  }

  .hero__soft {
    display: block;
    color: var(--muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  /* The phone stands slightly turned, as a product in a studio does, with two
     cards left on the table behind it. On narrow screens it faces the reader
     and the cards tuck in closer. */
  .hero__stage {
    position: relative;
    display: grid;
    place-items: center;
    padding-block: 2rem 3rem;
    perspective: 1600px;
  }

  .hero__stage :global(.hero__phone) {
    position: relative;
    z-index: 2;
    transform: rotateY(-12deg) rotateX(4deg) rotateZ(1deg);
    transform-origin: 50% 60%;
    filter: drop-shadow(0 40px 60px rgb(0 0 0 / 0.6));
  }

  .hero__stage :global(.hero__card) {
    position: absolute;
    z-index: 1;
    --card-w: clamp(4.4rem, 7.5vw, 6.5rem);
  }

  .hero__stage :global(.hero__card--a) {
    left: 8%;
    bottom: 12%;
    transform: rotate(-16deg);
  }

  .hero__stage :global(.hero__card--k) {
    right: 6%;
    top: 8%;
    transform: rotate(13deg);
    z-index: 3;
  }

  @media (max-width: 879px) {
    .hero__stage :global(.hero__phone) {
      transform: none;
    }
    .hero__stage :global(.hero__card--a) { left: 3%; }
    .hero__stage :global(.hero__card--k) { right: 5%; }
  }

  /* The facts strip: the dealer's plate under the table. */
  .facts {
    margin: clamp(2rem, 5vw, 4rem) 0 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--border-soft);
    border-bottom: 1px solid var(--border-soft);
  }

  @media (min-width: 720px) {
    .facts {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .facts__item {
    padding: 1.25rem 1rem 1.25rem 0;
    border-right: 1px solid var(--border-soft);
  }

  .facts__item:nth-child(even) {
    padding-left: 1.25rem;
    border-right: 0;
  }

  @media (min-width: 720px) {
    .facts__item {
      padding-inline: 1.5rem;
    }
    .facts__item:first-child { padding-left: 0; }
    .facts__item:nth-child(even) { border-right: 1px solid var(--border-soft); }
    .facts__item:last-child { border-right: 0; }
  }

  .facts dd {
    margin: 0.35rem 0 0;
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  /* ---- Scenes ---------------------------------------------------------- */

  .scenes {
    display: grid;
    gap: clamp(4rem, 9vw, 7rem);
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .scene {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  @media (min-width: 820px) {
    .scene {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .scene--flip .scene__stage {
      order: -1;
    }
  }

  .scene__copy > * + * {
    margin-top: 1rem;
  }

  .scene__copy h3 {
    font-size: var(--step-3);
    letter-spacing: -0.03em;
    line-height: 1.08;
  }

  .scene__body {
    color: var(--muted);
    max-width: var(--measure);
    font-size: var(--step-1);
    line-height: 1.55;
  }

  .scene__points {
    list-style: none;
    padding: 0;
    margin-top: 1.5rem;
    display: grid;
    gap: 0.5rem;
  }

  .scene__points li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    color: var(--text);
  }

  .scene__points li::before {
    content: '';
    flex: 0 0 auto;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--accent);
    translate: 0 -0.1rem;
  }

  /* Two devices on one small stage: the front one down-left, the second
     behind it up-right, the way two phones lie on a desk. The stage keeps its
     own proportion so the pair scales as one object. */
  .scene__stage {
